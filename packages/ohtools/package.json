{
  "name": "@bosun-sh/ohtools",
  "version": "0.2.0",
  "description": "Bun-first framework for explorable AI tools with MCP and CLI adapters.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "bosun.sh",
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "typescript",
    "bun",
    "mcp",
    "tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosun-sh/ohtools.git"
  },
  "homepage": "https://github.com/bosun-sh/ohtools#readme",
  "bugs": {
    "url": "https://github.com/bosun-sh/ohtools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ohtools": "./dist/bin/ohtools.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp.d.ts",
      "import": "./dist/adapters/mcp.js"
    },
    "./adapters/cli": {
      "types": "./dist/adapters/cli.d.ts",
      "import": "./dist/adapters/cli.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts ./src/schemas.ts ./src/adapters/mcp.ts ./src/adapters/cli.ts ./src/bin/ohtools.ts --outdir ./dist --target bun --format esm && tsc -p tsconfig.build.json && bun ../../scripts/fix-declarations.ts && chmod +x dist/bin/ohtools.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run --cwd ../.. pack:check",
    "publish:release": "bun run --cwd ../.. release:check && npm publish --access public",
    "publish:npm": "npm publish --access public",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.13.10"
  }
}
