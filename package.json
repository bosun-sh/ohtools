{
  "name": "ohtools-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "precommit": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "ci:precommit": "bun run format:check && bun run lint && bun run typecheck",
    "ci:lint": "bun run format:check && bun run lint && bun run typecheck",
    "ci:build": "bun run --filter '*' build",
    "ci:test": "bun test",
    "ci:premerge": "bun run ci:lint && bun run ci:test && bun run ci:build",
    "docs:dev": "bun --cwd apps/docs dev",
    "docs:build": "bun --cwd apps/docs build",
    "docs:links": "bun run scripts/docs-link-check.ts",
    "docs:snippets": "bun run scripts/docs-snippet-check.ts",
    "examples:check": "bun run scripts/examples-check.ts",
    "pack:check": "bun run scripts/pack-check.ts",
    "smoke:packed": "bun run scripts/smoke-packed.ts",
    "smoke:npm": "bun run scripts/smoke-npm.ts",
    "publish:ohtools": "bun run --cwd packages/ohtools publish:release",
    "publish:npm": "npm publish --access public -w packages/ohtools",
    "validate": "bun run typecheck && bun run lint && bun test && bun run examples:check && bun run docs:build && bun run docs:links && bun run docs:snippets && bun run pack:check && bun run smoke:packed",
    "release:check": "bun run validate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.13.10"
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.0.6",
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.3",
    "astro": "^5.1.1",
    "expect-type": "^1.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2"
  }
}
